# Browser build (Vite). ONLY public values belong here: these end up in the JS bundle.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# WebMCP Origin Trial token (Chrome 146+). Public token bound to your production origin.
# Register at https://developer.chrome.com/origintrials/#/view_trials
# Leave empty on localhost or during development.
VITE_WEBMCP_ORIGIN_TRIAL_TOKEN=
